// Landing page at /, vault app at /app (client-side routes) from ./dist.
// worker/index.ts handles /api/* (stats, faucet, Telegram webhook) and a 10-minute cron (keeper + bot alerts).
// Secrets (wrangler secret put): KEEPER_KEY, ANTHROPIC_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET.
{
  "name": "tiller-finance",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "TILLER", "id": "3b5fcbf7254448a0bcaa62b02c4c45a7" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "tillerfinance.xyz", "custom_domain": true },
    { "pattern": "www.tillerfinance.xyz", "custom_domain": true }
  ]
}
