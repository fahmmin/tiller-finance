// Static site on Cloudflare: landing page at /, vault app at /app (client-side route).
{
  "name": "tiller-finance",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "tillerfinance.xyz", "custom_domain": true },
    { "pattern": "www.tillerfinance.xyz", "custom_domain": true }
  ]
}
